  }
},
{
  text: "Bạn cảm thấy điều gì là nền tảng của một cuộc sống tốt?",
  options: {
    A: "Sự trung thực và chính trực" , group: "trung_thuc",
    B: "Sự kết nối và yêu thương" , group: "ket_noi",
    C: "Sự phát triển và học hỏi không ngừng" , group: "phat_trien",
    D: "Sự đóng góp và tạo giá trị cho người khác" , group: "phuc_vu"
  }
}
{
  text: "Khi làm việc nhóm, bạn thường đóng vai trò nào?",
  options: {
    A: "Người kết nối và tạo không khí hòa hợp" , group: "ket_noi",
    B: "Người đảm bảo tiến độ và kết quả" , group: "thanh_tuu",
    C: "Người đưa ra ý tưởng mới" , group: "phat_trien",
    D: "Người giữ sự ổn định và kiểm soát" , group: "an_toan"
  }
},
{
  text: "Bạn thường cảm thấy mất phương hướng khi...",
  options: {
    A: "Không có mục tiêu rõ ràng" , group: "thanh_tuu",
    B: "Không có ai đồng hành" , group: "ket_noi",
    C: "Không được sống đúng với giá trị cá nhân" , group: "trung_thuc",
    D: "Không thấy ý nghĩa trong việc đang làm" , group: "tam_linh"
  }
},
{
  text: "Bạn thường chọn cách giải trí nào?",
  options: {
    A: "Đi chơi với bạn bè hoặc gia đình" , group: "ket_noi",
    B: "Tự do khám phá nơi mới" , group: "tu_do",
    C: "Xem tài liệu, học hỏi thêm" , group: "phat_trien",
    D: "Thiền, đọc sách tâm linh" , group: "tam_linh"
  }
},
{
  text: "Bạn cảm thấy điều gì khiến bạn thấy mình có giá trị?",
  options: {
    A: "Được người khác tin tưởng và tôn trọng" , group: "trung_thuc",
    B: "Được tự do thể hiện bản thân" , group: "tu_do",
    C: "Được đóng góp cho cộng đồng" , group: "phuc_vu",
    D: "Được phát triển và tiến bộ" , group: "phat_trien"
  }
},
{
  text: "Bạn thường phản ứng thế nào khi bị chỉ trích?",
  options: {
    A: "Lắng nghe để cải thiện bản thân" , group: "phat_trien",
    B: "Giữ bình tĩnh để bảo vệ sự ổn định" , group: "an_toan",
    C: "Phản hồi thẳng thắn nếu thấy không công bằng" , group: "trung_thuc",
    D: "Tìm người thân để chia sẻ cảm xúc" , group: "ket_noi"
  }
},
{
  text: "Bạn cảm thấy điều gì là quan trọng nhất trong mối quan hệ?",
  options: {
    A: "Sự trung thực và tin tưởng" , group: "trung_thuc",
    B: "Sự kết nối và đồng cảm" , group: "ket_noi",
    C: "Sự tự do và không kiểm soát nhau" , group: "tu_do",
    D: "Sự hỗ trợ và giúp đỡ lẫn nhau" , group: "phuc_vu"
  }
},
{
  text: "Bạn thường cảm thấy động lực khi...",
  options: {
    A: "Có mục tiêu rõ ràng để đạt được" , group: "thanh_tuu",
    B: "Được học hỏi điều mới" , group: "phat_trien",
    C: "Được sống đúng với giá trị cá nhân" , group: "trung_thuc",
    D: "Được tạo ảnh hưởng tích cực cho người khác" , group: "phuc_vu"
  }
},
{
  text: "Bạn thường chọn cách phản ứng khi gặp bất công?",
  options: {
    A: "Lên tiếng bảo vệ sự thật" , group: "trung_thuc",
    B: "Tìm cách giúp người bị ảnh hưởng" , group: "phuc_vu",
    C: "Giữ bình tĩnh và tránh xung đột" , group: "an_toan",
    D: "Tìm hiểu sâu hơn để hiểu bản chất vấn đề" , group: "tam_linh"
  }
},
{
  text: "Bạn cảm thấy điều gì khiến bạn thấy an toàn?",
  options: {
    A: "Môi trường sống ổn định và có thể kiểm soát" , group: "an_toan",
    B: "Có người thân bên cạnh" , group: "ket_noi",
    C: "Được sống đúng với bản thân" , group: "tu_do",
    D: "Có niềm tin vào điều lớn hơn" , group: "tam_linh"
  }
},
{
  text: "Bạn thường cảm thấy ý nghĩa khi...",
  options: {
    A: "Được đóng góp cho người khác" , group: "phuc_vu",
    B: "Được phát triển và trưởng thành" , group: "phat_trien",
    C: "Được sống tự do và không bị ràng buộc" , group: "tu_do",
    D: "Được kết nối với điều thiêng liêng" , group: "tam_linh"
  }
},
{
  text: "Bạn thường cảm thấy mất kết nối khi...",
  options: {
    A: "Không có ai để chia sẻ cảm xúc" , group: "ket_noi",
    B: "Không được sống thật với chính mình" , group: "trung_thuc",
    C: "Không thấy ý nghĩa trong cuộc sống" , group: "tam_linh",
    D: "Không có mục tiêu rõ ràng" , group: "thanh_tuu"
  }
},
{
  text: "Bạn cảm thấy điều gì là nền tảng để sống hạnh phúc?",
  options: {
    A: "Sự kết nối và yêu thương" , group: "ket_noi",
    B: "Sự tự do và lựa chọn cá nhân" , group: "tu_do",
    C: "Sự phát triển và học hỏi" , group: "phat_trien",
    D: "Sự đóng góp và tạo giá trị cho người khác" , group: "phuc_vu"
  }
}

    ];

    const groups = {
      tu_do: "🕊️ Tự do cá nhân – Bạn đề cao sự độc lập, tự chủ và khả năng lựa chọn cuộc sống theo cách riêng.",
      ket_noi: "🤝 Kết nối xã hội – Bạn trân trọng các mối quan hệ, sự gắn bó và tình cảm chân thành.",
      phat_trien: "📚 Phát triển bản thân – Bạn luôn tìm cách học hỏi, khám phá và mở rộng giới hạn.",
      trung_thuc: "🧭 Trung thực & chính trực – Bạn sống thật, minh bạch và coi trọng sự đáng tin.",
      thanh_tuu: "🏆 Thành tựu & hiệu quả – Bạn hướng đến kết quả, thành công và sự công nhận.",
      tam_linh: "🧘 Tâm linh & ý nghĩa – Bạn tìm kiếm chiều sâu nội tâm, sự kết nối với điều lớn hơn.",
      an_toan: "🛡️ An toàn & ổn định – Bạn cần sự kiểm soát, bảo vệ và môi trường sống vững chắc.",
      phuc_vu: "🌱 Phục vụ & đóng góp – Bạn có trái tim tử tế, luôn muốn tạo giá trị cho người khác."
    };

    // Tạo câu hỏi
    const form = document.getElementById("testForm");
    questions.forEach((q, i) => {
      const div = document.createElement("div");
      div.className = "question";
      div.innerHTML = `<h3>Câu ${i + 1}: ${q.text}</h3>`;
      Object.entries(q.options).forEach(([key, value]) => {
        div.innerHTML += `
          <label>
            <input type="radio" name="q${i}" value="${value.group}"> ${key}. ${value}
          </label>
        `;
      });
      form.appendChild(div);
    });

    function calculate() {
      const scores = {};
      Object.keys(groups).forEach(g => scores[g] = 0);

      questions.forEach((_, i) => {
        const selected = document.querySelector(`input[name="q${i}"]:checked`);
        if (selected) scores[selected.value]++;
      });

      const sorted = Object.entries(scores).sort((a, b) => b[1] - a[1]);
      const top3 = sorted.slice(0, 3);

      const resultBox = document.getElementById("result");
      resultBox.style.display = "block";
      resultBox.innerHTML = `<h3>Kết quả phân tích giá trị cá nhân:</h3><ul>
        ${top3.map(([key]) => `<li>${groups[key]}</li>`).join("")}
      </ul>
      <p><em>Dựa trên mô hình giá trị cá nhân của Richard Barrett – chuyên gia phát triển con người và tổ chức. Tham khảo: Barrett Values Centre.</em></p>`;
    }
  </script>
</body>
</html>
