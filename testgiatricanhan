    B: "Lợi ích cho cộng đồng hoặc người khác" , group: "phuc_vu",
    C: "Khả năng phát triển bản thân" , group: "phat_trien",
    D: "Sự tự do và linh hoạt" , group: "tu_do"
  }
},
{
  text: "Khi gặp thử thách, bạn thường...",
  options: {
    A: "Tìm cách vượt qua để đạt mục tiêu" , group: "thanh_tuu",
    B: "Tìm người đồng hành hoặc hỗ trợ" , group: "ket_noi",
    C: "Tạm dừng để suy ngẫm và điều chỉnh" , group: "tam_linh",
    D: "Giữ sự ổn định và an toàn trước tiên" , group: "an_toan"
  }
},
{
  text: "Bạn cảm thấy được là chính mình khi...",
  options: {
    A: "Không bị ai áp đặt hay kiểm soát" , group: "tu_do",
    B: "Được sống đúng với giá trị và niềm tin" , group: "trung_thuc",
    C: "Được kết nối và chia sẻ với người khác" , group: "ket_noi",
    D: "Được học hỏi và khám phá điều mới" , group: "phat_trien"
  }
},
{
  text: "Bạn thường cảm thấy ý nghĩa sống đến từ...",
  options: {
    A: "Sự đóng góp cho người khác" , group: "phuc_vu",
    B: "Sự phát triển và trưởng thành cá nhân" , group: "phat_trien",
    C: "Sự kết nối với điều lớn hơn bản thân" , group: "tam_linh",
    D: "Sự tự do trong lựa chọn cuộc sống" , group: "tu_do"
  }
},
{
  text: "Bạn đánh giá cao người khác khi họ...",
  options: {
    A: "Sống thật và minh bạch" , group: "trung_thuc",
    B: "Có lòng tốt và hay giúp đỡ" , group: "phuc_vu",
    C: "Có tư duy sáng tạo và ham học hỏi" , group: "phat_trien",
    D: "Biết giữ sự ổn định và kiểm soát" , group: "an_toan"
  }
},
{
  text: "Bạn cảm thấy hạnh phúc nhất khi...",
  options: {
    A: "Được tự do làm điều mình yêu thích" , group: "tu_do",
    B: "Có người thân bên cạnh" , group: "ket_noi",
    C: "Được sống đúng với giá trị của mình" , group: "trung_thuc",
    D: "Được đóng góp cho cộng đồng" , group: "phuc_vu"
  }
},
{
  text: "Bạn thường chọn môi trường sống như thế nào?",
  options: {
    A: "Yên bình, ổn định" , group: "an_toan",
    B: "Tự do, linh hoạt" , group: "tu_do",
    C: "Có cộng đồng gắn bó" , group: "ket_noi",
